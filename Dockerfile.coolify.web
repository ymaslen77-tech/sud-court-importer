# Coolify web image. Preserve the existing Node.js/pnpm versions.
# npm registry may be slow or briefly unreachable from the VPS Docker network.
# Retry only downloads; do not skip builds, disable TLS or use untrusted mirrors.
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# npm's registry requests timed out on 26 Nov 2026 during the first global install.
# Cache successful downloads across builds and prefer IPv4 when IPv6 is broken.
ENV NODE_OPTIONS=--dns-result-order=ipv4first \
    NPM_CONFIG_REGISTRY=https://registry.npmjs.org/ \
    NPM_CONFIG_FETCH_RETRIES=3 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=10000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=60000 \
    NPM_CONFIG_FETCH_TIMEOUT=120000

RUN --mount=type=cache,id=sudy-web-npm-cache,target=/root/.npm \
    set -eu; \
    for attempt in 1 2 3; do \
      if npm install -g --no-audit --no-fund --prefer-offline pnpm@10.15.0; then break; fi; \
      if [ "$attempt" -eq 3 ]; then \
        echo "ERROR: npm registry unreachable after three attempts; check VPS DNS/HTTPS proxy and Docker outbound network." >&2; \
        exit 1; \
      fi; \
      echo "pnpm download failed (attempt $attempt/3); retrying from the official npm registry." >&2; \
      sleep $((attempt * 10)); \
    done; \
    test "$(pnpm --version)" = "10.15.0"

COPY . .
RUN --mount=type=cache,id=sudy-web-pnpm-store,target=/pnpm/store \
    set -eu; \
    for attempt in 1 2 3; do \
      if pnpm install --no-frozen-lockfile --store-dir /pnpm/store; then break; fi; \
      if [ "$attempt" -eq 3 ]; then \
        echo "ERROR: pnpm dependencies could not be downloaded; check Docker egress and DNS." >&2; \
        exit 1; \
      fi; \
      echo "Dependency download failed (attempt $attempt/3); retrying." >&2; \
      sleep $((attempt * 10)); \
    done

ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @courts/web build

FROM node:22-bookworm-slim
WORKDIR /app

# Reuse the already downloaded, version-pinned pnpm from the builder.
# Do NOT contact npmjs.org again in the runtime image.
COPY --from=builder /usr/local/lib/node_modules/pnpm /usr/local/lib/node_modules/pnpm
RUN ln -s /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
    && test "$(pnpm --version)" = "10.15.0"
COPY --from=builder --chown=node:node /app /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@courts/web", "start"]
